# Copy to .env (repo root) and adjust. Read by sandbox/core/settings.py.
# Local development — this is all a fresh clone needs (SQLite, console email):
DJANGO_DEBUG=1

# Production (see the live site's .env for real values):
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<long random string>   # required when DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=example.com,localhost,127.0.0.1
# DJANGO_DB_NAME=...                       # set to switch from SQLite to Postgres
# DJANGO_DB_USER=...
# DJANGO_DB_PASSWORD=...
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# Optional: AI post generation
# POSTINO_LLM_PROVIDER=openai
# POSTINO_LLM_MODEL=gpt-6-luna
# POSTINO_LLM_API_KEY=
# POSTINO_LLM_REASONING_EFFORT=medium
